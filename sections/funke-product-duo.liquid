<style>
  .funke-duo {
    background: {{ section.settings.bg_color }};
    padding: 8rem 0;
    position: relative;
  }

  .funke-duo::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #C9A84C, transparent);
  }

  .funke-duo__inner {
    max-width: 130rem;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .funke-duo__header {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-bottom: 5.5rem;
  }

  .funke-duo__header-line {
    display: block;
    width: 4rem;
    height: 1px;
    background: #C9A84C;
    flex-shrink: 0;
  }

  .funke-duo__header-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #C9A84C;
  }

  .funke-duo__carousel {
    position: relative;
    max-width: 60rem;
    margin: 0 auto;
  }

  .funke-duo__viewport {
    overflow: hidden;
  }

  .funke-duo__track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .funke-duo__slide {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .funke-duo__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.6rem;
    margin-top: 3.2rem;
  }

  .funke-duo__arrow {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0.5rem;
    margin: 0;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 1.8rem;
    line-height: 1;
    color: rgba(28, 28, 30, 0.55);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .funke-duo__arrow:hover,
  .funke-duo__arrow:focus-visible {
    color: #C9A84C;
  }

  .funke-duo__arrow--prev:hover { transform: translateX(-3px); }
  .funke-duo__arrow--next:hover { transform: translateX(3px); }

  .funke-duo__dots {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .funke-duo__dot {
    width: 0.8rem;
    height: 0.8rem;
    padding: 0;
    border: 1px solid rgba(201, 168, 76, 0.5);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .funke-duo__dot.is-active {
    background: #C9A84C;
    transform: scale(1.15);
  }

  /* ---- Card ---- */
  .funke-duo-card {
    display: flex;
    flex-direction: column;
    background: #F5F0E8;
    border: 1px solid rgba(201, 168, 76, 0.35);
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }

  .funke-duo-card:hover {
    box-shadow: 0 8px 32px rgba(28, 28, 30, 0.10);
  }

  .funke-duo-card__img-wrap {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #EDE8DC;
    text-decoration: none;
  }

  .funke-duo-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .funke-duo-card:hover .funke-duo-card__img {
    transform: scale(1.03);
  }

  .funke-duo-card__body {
    padding: 3rem 3rem 3.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    border-top: 1px solid rgba(201, 168, 76, 0.35);
  }

  .funke-duo-card__type {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .funke-duo-card__name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #1C1C1E;
    line-height: 1;
    margin: 0 0 1.4rem;
    text-decoration: none;
    display: block;
  }

  .funke-duo-card__name:hover {
    color: #C9A84C;
  }

  .funke-duo-card__desc {
    font-family: 'Inter', sans-serif;
    font-size: 1.45rem;
    line-height: 1.7;
    color: rgba(28, 28, 30, 0.60);
    margin: 0 0 2.8rem;
    flex: 1;
  }

  .funke-duo-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-top: auto;
  }

  .funke-duo-card__price-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .funke-duo-card__preorder {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1C1C1E;
    background: rgba(201, 168, 76, 0.18);
    padding: 0.25rem 0.7rem;
    display: inline-block;
  }

  .funke-duo-card__price {
    font-family: 'Inter', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #1C1C1E;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .funke-duo-card__btn {
    display: inline-block;
    background: #1C1C1E;
    color: #F5F0E8;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    letter-spacing: 0.14em;
    padding: 1.2rem 2.8rem;
    text-decoration: none;
    transition: background 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .funke-duo-card__btn:hover {
    background: #3A3A3A;
    color: #F5F0E8;
  }

  .funke-duo-card__gold-bar {
    position: absolute;
    bottom: 0; left: 0;
    width: 0;
    height: 2px;
    background: #C9A84C;
    transition: width 0.4s ease;
  }

  .funke-duo-card:hover .funke-duo-card__gold-bar {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .funke-duo {
      padding: 6rem 0;
    }
    .funke-duo__inner {
      padding: 0 2rem;
    }
    .funke-duo__controls {
      margin-top: 2.4rem;
      gap: 2rem;
    }
    .funke-duo-card__name {
      font-size: 3rem;
    }
  }
</style>

<section class="funke-duo">
  <div class="funke-duo__inner">

    <div class="funke-duo__header">
      <span class="funke-duo__header-line"></span>
      <span class="funke-duo__header-text">{{ section.settings.eyebrow | default: 'The Collection' }}</span>
    </div>

    <div
      class="funke-duo__carousel"
      data-duo-carousel
      data-autoplay="{{ section.settings.enable_autoplay }}"
      data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
    >
      <div class="funke-duo__viewport">
        <div class="funke-duo__track" data-duo-track>
          {%- for i in (1..2) -%}
            {%- assign pid = 'product_' | append: i -%}
            {%- assign prod = section.settings[pid] -%}

            {%- if prod != blank -%}
              <div class="funke-duo__slide" data-duo-slide>
                <article class="funke-duo-card">
                  <a href="{{ prod.url }}" class="funke-duo-card__img-wrap" aria-label="{{ prod.title | escape }}">
                    {%- if prod.featured_image != blank -%}
                      <img
                        src="{{ prod.featured_image | image_url: width: 900 }}"
                        alt="{{ prod.featured_image.alt | escape | default: prod.title }}"
                        class="funke-duo-card__img"
                        loading="{% if i == 1 %}eager{% else %}lazy{% endif %}"
                        width="900"
                        height="900"
                      >
                    {%- endif -%}
                  </a>
                  <div class="funke-duo-card__body">
                    <span class="funke-duo-card__type">{{ prod.type | default: 'Car Fragrance' }}</span>
                    <a href="{{ prod.url }}" class="funke-duo-card__name">{{ prod.title }}</a>
                    <p class="funke-duo-card__desc">{{ prod.description | strip_html | truncate: 100 }}</p>
                    <div class="funke-duo-card__footer">
                      <div class="funke-duo-card__price-wrap">
                        {%- if prod.available == false -%}
                          <span class="funke-duo-card__preorder">Pre-order</span>
                        {%- endif -%}
                        <span class="funke-duo-card__price">{{ prod.price | money }}</span>
                      </div>
                      <a href="{{ prod.url }}" class="funke-duo-card__btn">VIEW PRODUCT</a>
                    </div>
                  </div>
                  <div class="funke-duo-card__gold-bar"></div>
                </article>
              </div>

            {%- else -%}

              {%- assign fallback_titles = 'FUNKE Starter Kit,FUNKE Disc Refill' | split: ',' -%}
              {%- assign fallback_types = 'Complete System,Disc Refill' | split: ',' -%}
              {%- assign fallback_descs = 'Zinc alloy vent clip diffuser + fragrance oil + 3 cotton discs. Everything you need to start your FUNKE experience.,Premium cotton disc inserts for your FUNKE vent clip diffuser. Available in RIVIERA and MONACO.' | split: ',' -%}
              {%- assign fallback_prices = '$49.00,$24.00' | split: ',' -%}
              {%- assign idx = forloop.index0 -%}

              <div class="funke-duo__slide" data-duo-slide>
                <article class="funke-duo-card">
                  <a href="{{ routes.all_products_collection_url }}" class="funke-duo-card__img-wrap"></a>
                  <div class="funke-duo-card__body">
                    <span class="funke-duo-card__type">{{ fallback_types[idx] }}</span>
                    <span class="funke-duo-card__name">{{ fallback_titles[idx] }}</span>
                    <p class="funke-duo-card__desc">{{ fallback_descs[idx] }}</p>
                    <div class="funke-duo-card__footer">
                      <div class="funke-duo-card__price-wrap">
                        <span class="funke-duo-card__preorder">Pre-order</span>
                        <span class="funke-duo-card__price">{{ fallback_prices[idx] }}</span>
                      </div>
                      <a href="{{ routes.all_products_collection_url }}" class="funke-duo-card__btn">VIEW PRODUCT</a>
                    </div>
                  </div>
                  <div class="funke-duo-card__gold-bar"></div>
                </article>
              </div>

            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="funke-duo__controls">
        <button type="button" class="funke-duo__arrow funke-duo__arrow--prev" data-duo-prev aria-label="Previous product">&larr;</button>
        <div class="funke-duo__dots" data-duo-dots>
          <button type="button" class="funke-duo__dot is-active" data-duo-dot="0" aria-label="Show slide 1" aria-current="true"></button>
          <button type="button" class="funke-duo__dot" data-duo-dot="1" aria-label="Show slide 2" aria-current="false"></button>
        </div>
        <button type="button" class="funke-duo__arrow funke-duo__arrow--next" data-duo-next aria-label="Next product">&rarr;</button>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    var carousels = document.querySelectorAll('[data-duo-carousel]');
    carousels.forEach(function (carousel) {
      if (carousel.dataset.duoInit) return;
      carousel.dataset.duoInit = 'true';

      var track = carousel.querySelector('[data-duo-track]');
      var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-duo-slide]'));
      var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-duo-dot]'));
      var prevBtn = carousel.querySelector('[data-duo-prev]');
      var nextBtn = carousel.querySelector('[data-duo-next]');
      var total = slides.length;
      var index = 0;
      var timer = null;
      var autoplay = carousel.dataset.autoplay === 'true';
      var interval = parseInt(carousel.dataset.interval, 10) || 6000;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function render() {
        track.style.transform = 'translateX(-' + (index * 100) + '%)';
        dots.forEach(function (dot, i) {
          var active = i === index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
      }

      function goTo(i) {
        index = (i + total) % total;
        render();
      }

      function next() { goTo(index + 1); }
      function prev() { goTo(index - 1); }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function start() {
        if (!autoplay || reduceMotion || total < 2) return;
        stop();
        timer = setInterval(next, interval);
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { prev(); stop(); start(); });
      if (nextBtn) nextBtn.addEventListener('click', function () { next(); stop(); start(); });
      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { goTo(i); stop(); start(); });
      });

      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', start);

      render();
      start();
    });
  })();
</script>

{% schema %}
{
  "name": "FUNKE Product Duo",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Collection"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1 (Starter Kit)"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2 (Disc Refill)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-advance Speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "FUNKE Product Duo",
      "settings": {
        "eyebrow": "The Collection"
      }
    }
  ]
}
{% endschema %}
